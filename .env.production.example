# Copy to .env on the server. Generate every *_PASSWORD and JWT_SECRET with:
# openssl rand -base64 48
FORMA_PUBLIC_ORIGIN=https://forma.example.com
# Public HTTPS origin used in signed self-hosted email-verification links.
FORMA_WEB_APP_BASE_URL=https://forma.example.com

POSTGRES_DB=forma
POSTGRES_USER=forma
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET

RABBITMQ_DEFAULT_USER=forma
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_A_LONG_RANDOM_SECRET
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_A_32_BYTE_OR_LONGER_RANDOM_SECRET

# Required only when enabling the corresponding external integration.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://forma.example.com/api/v1/integrations/calendar/google/callback
INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_A_32_BYTE_URLSAFE_BASE64_KEY
RESEND_API_KEY=
RESEND_FROM_EMAIL=
